# --- Lab ClickHouse + OMOP (données fictives) ---
# Changer les mots de passe si la machine est partagée.
# Pas de commentaire en fin de ligne : ce fichier est lu par docker compose, make ET bash.

# PostgreSQL (bronze source + publication OMOP)
PG_USER=lab
PG_PASSWORD=lab_pg_pwd
PG_PORT=5432
# Rôle Postgres en lecture seule utilisé par ClickHouse pour répliquer le bronze
PG_CH_READER_PASSWORD=ch_reader_pwd

# ClickHouse : utilisateur des transformations dbt
CH_HTTP_PORT=8123
CH_USER=dbt
CH_PASSWORD=dbt_lab_pwd
# ClickHouse : utilisateur 'lecteur' (lecture seule) pour CH-UI, Grafana, DBeaver
CH_READER_UI_PASSWORD=lecteur_pwd

# Grafana (utilisateur admin)
GRAFANA_ADMIN_PASSWORD=admin_lab

# Génération : 1 ≈ 5 Go dans Postgres (linéaire ; 0.1 ≈ 500 Mo pour un premier essai)
SCALE=1

# dbt
DBT_THREADS=4

# Releases OMOP : nombre de releases archivées conservées (≈ 5,5 Go chacune à SCALE=1)
KEEP_RELEASES=1
# Flux de chargement parallèles ClickHouse -> Postgres
PARALLEL=4
